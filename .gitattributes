# Satır sonlarını depoda LF olarak tut. Böylece Windows ve macOS arasında
# gereksiz "tüm dosya değişti" diff'leri oluşmaz.
* text=auto eol=lf

# Cihaza yüklenen dosyalar — sunucuda olduğu gibi LF kalsın
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.svg  text eol=lf
*.ino  text eol=lf
*.h    text eol=lf
*.md   text eol=lf

# İkili dosyalar — asla dönüştürme
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.bin  binary