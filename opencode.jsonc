{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "ask"
    }
  ],
  "commands": {
    "surum": {
      "description": "Sürümü dört dosyada birlikte güncelle",
      "template": "Sürüm numarasını şu dört dosyada birlikte güncelle: package.json (version), pwa/js/config.js (App.VERSION), pwa/sw.js (VERSION), firmware/config.example.h (FW_VERSION). Mevcut sürüm: 2.3.0. Yeni sürümü sor, sonra `npm run check` çalıştır ve sonucu `git diff` ile göster."
    },
    "cihaz": {
      "description": "Firmware'i Arduino IDE yerine hızlıca derle (varsa)",
      "template": "firmware/ klasöründeki Arduino kodunu derle. config.h yoksa config.example.h'den kopyalayıp uyar. Derleme hatasını tam olarak raporla."
    },
    "pwa": {
      "description": "PWA'yı sahte cihazla ayağa kaldır ve kontrol et",
      "template": "`npm run dev` ile sahte cihazı başlat (port doluysa --port 5173 dene), paneli aç, konsol hatalarını kontrol et. Grafik ve bildirimlerin çalıştığını doğrula."
    },
    "PR": {
      "description": "Değişiklikleri gözden geçir ve PR özeti hazırla",
      "template": "Mevcut değişiklikleri `git diff main...HEAD` üzerinden incele. AGENTS.md kurallarına aykırı nokta var mı kontrol et (sürüm tutarlılığı, gizli bilgi, sw.js PRECACHE listesi). Bulguları madde madde özetle ve PR başlığı + açıklaması öner."
    }
  }
}