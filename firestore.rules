rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // YARDIMCI FONKSIYONLAR
    // ================================================================

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function getProfile(u) {
      return get(/databases/$(database)/documents/profiles/$(u)).data;
    }

    // Mevcut kullanici admin mi? (profiles/{uid}.role == 'admin')
    function isAdmin() {
      return signedIn() && getProfile(uid()) != null && getProfile(uid()).role == 'admin';
    }

    function isSelf(u) { return signedIn() && uid() == u; }

    // Cihaz baglama yardimcilari
    function deviceExists(id) {
      return exists(/databases/$(database)/documents/device_bindings/$(id));
    }
    function deviceData(id) {
      return get(/databases/$(database)/documents/device_bindings/$(id)).data;
    }
    function deviceOwner(id) { return deviceData(id).owner_id; }
    function deviceReleased(id) { return deviceData(id).status == 'release_pending'; }

    // ================================================================
    // PROFILES - kullanici profilleri (doc ID = uid)
    // ================================================================
    match /profiles/{userId} {
      // Giris yapmis herkes okuyabilir (admin listesi, mulkiyet etiketi,
      // ilk-kullanici tespiti ve kullanici adi gosterimi icin gerekli).
      allow read: if signedIn();

      // Kendi profilini olusturabilir (kayit akisi). Rol beyani sinirli.
      allow create: if isSelf(userId)
                    && request.resource.data.id == userId
                    && request.resource.data.role in ['user', 'admin'];

      // Kendi profilini veya admin herhangi birini guncelleyebilir.
      allow update: if isSelf(userId) || isAdmin();

      // Silme yalnizca admin.
      allow delete: if isAdmin();
    }

    // ================================================================
    // DEVICE_BINDINGS - cihaz mulkiyeti (doc ID = device_id)
    //
    //  * Cihaz BOSTA ise (dokuman yok): giris yapmis herkes "get" ile
    //    yoklugunu dogrulayabilir ve ilk baglayan sahibi olur.
    //  * Cihaz BAGLI ise: yalnizca SAHIBI ve ADMIN gorebilir.
    //    Admin disindaki hic kimse bagli cihazi GOREMEZ veya BAGLAYAMAZ.
    //  * Baglantiyi kesme: sahibi status'u 'release_pending' yapar ve
    //    cihaz KILITLI kalir. Yalnizca ADMIN onaylarsa (dokumani silerse)
    //    cihaz serbest kalir; ancak o zaman baska bir hesap baglanabilir.
    // ================================================================
    match /device_bindings/{deviceId} {

      // Tek dokuman okuma: bosta VEYA sahibi VEYA admin.
      allow get: if signedIn() && (
        !deviceExists(deviceId)
        || deviceOwner(deviceId) == uid()
        || isAdmin()
      );

      // Liste: admin tumunu; kullanici yalnizca KENDI kayitlarini gorur.
      // (Istemci sorgusu owner_id == uid ile kisitlanmalidir.)
      allow list: if signedIn() && (isAdmin() || resource.data.owner_id == uid());

      // Bagla: yalnizca BOSTA bir cihazi kendi adina, 'active' durumuyla.
      allow create: if signedIn()
                    && !deviceExists(deviceId)
                    && request.resource.data.owner_id == uid()
                    && request.resource.data.status == 'active';

      // Guncelle:
      //  * admin  -> her sey (onay, yeniden atama, serbest birakma)
      //  * sahibi -> YALNIZCA active <-> release_pending gecisi yapabilir
      //  * baskasi -> KESINLIKLE HAYIR
      allow update: if signedIn() && (
        isAdmin()
        || (
          deviceExists(deviceId)
          && deviceOwner(deviceId) == uid()
          && request.resource.data.owner_id == uid()
          && (
            (!deviceReleased(deviceId) && request.resource.data.status == 'release_pending')
            || (deviceReleased(deviceId) && request.resource.data.status == 'active')
          )
        )
      );

      // Silme = baglanti kesme onayi -> cihazi serbest birakir. Yalnizca admin.
      allow delete: if isAdmin();
    }

    // ================================================================
    // LOGIN_LOGS - giris/cikis etkinlik kayitlari
    // ================================================================
    match /login_logs/{logId} {
      // Yalnizca kendi adina kayit yazabilir.
      allow create: if signedIn() && request.resource.data.userId == uid();
      // Kendi kayitlarini veya admin tumunu okuyabilir.
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ================================================================
    // INVITES - davet kodlari
    // ================================================================
    match /invites/{code} {
      // Tek dokuman okuma serbest: kayit oncesi (henuz oturum yokken) dogrulanir.
      allow get: if true;
      // Liste/olusturma/silme yalnizca admin.
      allow list: if isAdmin();
      allow create, delete: if isAdmin();

      // Guncelleme: admin serbest; ayrica kayit olan kullanici KENDI adina,
      // yalnizca kullanilmamis bir daveti "kullanildi" isaretleyebilir.
      // Rol/kod/olusturan alanlari degistirilemez (yetki yukseltmesi engellenir).
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.used_by == uid()
        && request.resource.data.role == resource.data.role
        && request.resource.data.code == resource.data.code
        && request.resource.data.created_by == resource.data.created_by
      );
    }

    // ================================================================
    // AUDIT_LOGS - yonetici islem kayitlari
    // ================================================================
    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ================================================================
    // Diger her sey varsayilan olarak kapali
    // ================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
