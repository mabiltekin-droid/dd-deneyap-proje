rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // YARDIMCI FONKSIYONLAR
    // ================================================================

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function getProfile(u) {
      return get(/databases/$(database)/documents/profiles/$(u)).data;
    }

    // Mevcut kullanici admin mi? (profiles/{uid}.role == 'admin')
    // NOT: get() dokuman YOKKEN HATA verir. Bu yuzden once exists() ile
    // kontrol edilir. Aksi halde 'isAdmin() || ...' bicimindeki kurallarda
    // hata olusup TUM kural reddedilir; profil dokumani eksik olan bir
    // kullanici hicbir sey yapamaz (or. cihaz baglayamaz) hale gelir.
    function isAdmin() {
      return signedIn()
          && exists(/databases/$(database)/documents/profiles/$(uid()))
          && getProfile(uid()).role == 'admin';
    }

    function isSelf(u) { return signedIn() && uid() == u; }

    // ---------------------------------------------------------------
    // ADIM YUKSELTME (step-up) - kritik yazmalar icin TAZE GIRIS sarti
    //
    //  auth_time = ID token'in "son kimlik dogrulama" damgasidir (saniye).
    //  Token'i Firebase imzalar; istemci bu degeri DEGISTIREMEZ. Boylece
    //  calinmis/uzun suredir acik bir oturum; rol degistirme, davet uretme,
    //  aktivasyon kodu yazma veya cihaz baglama gibi islemleri yapamaz;
    //  kullanicinin sifresini yeniden girmesi (reauthenticate) gerekir.
    //
    //  Iki kademe vardir:
    //    freshSignIn()  = 15 dk → yonetici/kritik islemler
    //    recentSignIn() = 60 dk → gunluk cihaz islemleri (baglama/birakma)
    // ---------------------------------------------------------------
    function signInWithin(seconds) {
      return signedIn()
          && 'auth_time' in request.auth.token
          && (request.auth.token.auth_time * 1000) > (request.time.toMillis() - seconds * 1000);
    }

    function freshSignIn() { return signInWithin(900); }    // 15 dakika
    function recentSignIn() { return signInWithin(3600); }  // 60 dakika

    // E-posta dogrulanmis mi? (ID token claim'i; kritik yazmalarda istenir.)
    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // Profil rolu (alan yoksa 'user' varsayilir) ---------------------------
    function roleOf(d) { return 'role' in d ? d.role : 'user'; }

    // DAVET KODU YARDIMCILARI ---------------------------------------------
    // 'admin' rolu YALNIZCA gecerli bir ADMIN davetiyle veya ilk-kurulum
    // isaretiyle verilebilir. Boylece kayitli bir kullanici kendi profilini
    // 'admin' yaparak yetki yukseltemez.
    function inviteExists(code) {
      return exists(/databases/$(database)/documents/invites/$(code));
    }
    function inviteData(code) {
      return get(/databases/$(database)/documents/invites/$(code)).data;
    }
    // data: yazilmak istenen profil dokumani. Once alanin VARLIGI kontrol
    // edilir; sonra exists() ile korunur (exists olmayan dokumanda get() hata
    // verir ve tum kurali reddederdi).
    function hasAdminInvite(data) {
      return data.keys().hasAny(['invite_code'])
          && data.invite_code is string
          && data.invite_code.size() > 0
          && inviteExists(data.invite_code)
          && inviteData(data.invite_code).role == 'admin'
          && inviteData(data.invite_code).used == false;
    }

    // ILK-KURULUM ISARETI -------------------------------------------------
    // Kural motoru koleksiyon SAYAMADIGI icin "ilk kullanici" bir isaret
    // dokumaniyla belirlenir: config/bootstrap yalnizca BIR KEZ olusturulabilir
    // ve yazan kisiye kilitlenir; sunucu tarafi bu uid'yi dogrular.
    function bootstrapOwner() {
      return exists(/databases/$(database)/documents/config/bootstrap)
          && get(/databases/$(database)/documents/config/bootstrap).uid == uid();
    }

    // Cihaz baglama yardimcilari
    function deviceExists(id) {
      return exists(/databases/$(database)/documents/device_bindings/$(id));
    }
    function deviceData(id) {
      return get(/databases/$(database)/documents/device_bindings/$(id)).data;
    }
    function deviceOwner(id) { return deviceData(id).owner_id; }
    function deviceReleased(id) { return deviceData(id).status == 'release_pending'; }

    // Aktivasyon kodu yardimcilari.
    // device_codes dokumanini YALNIZCA admin okuyabilir; asagidaki get()
    // cagrilari sunucu tarafinda calistigi icin kurallar degeri gorebilir,
    // istemci ise goremez.
    function codeExists(id) {
      return exists(/databases/$(database)/documents/device_codes/$(id));
    }
    function codeData(id) {
      return get(/databases/$(database)/documents/device_codes/$(id)).data;
    }
    function unlockExists(id) {
      return exists(/databases/$(database)/documents/device_unlocks/$(id));
    }
    function unlockUid(id) {
      return get(/databases/$(database)/documents/device_unlocks/$(id)).data.uid;
    }

    // ================================================================
    // PROFILES - kullanici profilleri (doc ID = uid)
    // ================================================================
    match /profiles/{userId} {
      // Giris yapmis herkes okuyabilir (admin listesi, mulkiyet etiketi,
      // ilk-kullanici tespiti ve kullanici adi gosterimi icin gerekli).
      allow read: if signedIn();

      // Olusturma: kayit akisinda KENDI profilini, panelden ADMIN baska bir
      // kullanici icin olusturabilir.
      // GUVENLIK: 'admin' rolu yalnizca admin, ilk-kurulum sahibi veya gecerli
      // bir ADMIN daveti ile verilebilir -> kendi kendine yetki yukseltme yok.
      allow create: if (isSelf(userId) || isAdmin())
                    && freshSignIn()
                    && (!('id' in request.resource.data) || request.resource.data.id == userId)
                    && (
                      isAdmin()
                      || roleOf(request.resource.data) == 'user'
                      || (
                        roleOf(request.resource.data) == 'admin'
                        && (bootstrapOwner() || hasAdminInvite(request.resource.data))
                      )
                    );

      // Guncelleme: admin her sey (ancak TAZE GIRIS ile; rol degistirmek
      // kritik bir islemdir). Kullanici KENDI profilini guncelleyebilir ama
      // 'id'/'role' alanlarini DEGISTIREMEZ; bu alanlar korundugu icin
      // gunluk profil duzenlemesi adim yukseltme istemez.
      allow update: if (isAdmin() && freshSignIn())
                    || (
                      isSelf(userId)
                      && (!('id' in request.resource.data) || request.resource.data.id == userId)
                      && roleOf(request.resource.data) == roleOf(resource.data)
                    );

      // Silme yalnizca admin.
      allow delete: if isAdmin();
    }

    // ================================================================
    // CONFIG - sistem isaretleri (yalnizca ilk-kurulum icin)
    // ================================================================
    match /config/bootstrap {
      allow get: if signedIn();
      // Yalnizca BIR KEZ olusturulur (var olan dokuman guncellenemez/silinemez)
      // ve yazan kisiye kilitlenir.
      allow create: if signedIn()
                    && freshSignIn()
                    && request.resource.data.uid == uid()
                    && !exists(/databases/$(database)/documents/config/bootstrap);
      allow update, delete: if false;
    }

    // ================================================================
    // DEVICE_BINDINGS - cihaz mulkiyeti (doc ID = device_id)
    //
    //  * Cihaz BOSTA ise (dokuman yok): giris yapmis herkes "get" ile
    //    yoklugunu dogrulayabilir ve ilk baglayan sahibi olur.
    //  * Cihaz BAGLI ise: yalnizca SAHIBI ve ADMIN gorebilir.
    //    Admin disindaki hic kimse bagli cihazi GOREMEZ veya BAGLAYAMAZ.
    //  * Baglantiyi kesme: sahibi status'u 'release_pending' yapar ve
    //    cihaz KILITLI kalir. Yalnizca ADMIN onaylarsa (dokumani silerse)
    //    cihaz serbest kalir; ancak o zaman baska bir hesap baglanabilir.
    // ================================================================
    match /device_bindings/{deviceId} {

      // Tek dokuman okuma: bosta VEYA sahibi VEYA admin.
      allow get: if signedIn() && (
        !deviceExists(deviceId)
        || deviceOwner(deviceId) == uid()
        || isAdmin()
      );

      // Liste: admin tumunu; kullanici yalnizca KENDI kayitlarini gorur.
      // (Istemci sorgusu owner_id == uid ile kisitlanmalidir.)
      allow list: if signedIn() && (isAdmin() || resource.data.owner_id == uid());

      // Bagla: yalnizca BOSTA bir cihazi kendi adina, 'active' durumuyla.
      // Sahibi olabilmek icin cihazin AKTIVASYON KODUNU dogru girmis olmasi
      // gerekir (device_unlocks kaydi). Admin kod olmadan atayabilir.
      // Ayrica: e-posta dogrulanmis ve son 60 dk icinde giris yapilmis olmali.
      allow create: if signedIn()
                    && recentSignIn()
                    && verifiedEmail()
                    && !deviceExists(deviceId)
                    && request.resource.data.owner_id == uid()
                    && request.resource.data.status == 'active'
                    && (
                      (unlockExists(deviceId) && unlockUid(deviceId) == uid())
                      || isAdmin()
                    );

      // Guncelle:
      //  * admin  -> her sey (onay, yeniden atama, serbest birakma) + TAZE GIRIS
      //  * sahibi -> YALNIZCA active <-> release_pending gecisi yapabilir
      //              (son 60 dk icinde giris yapmis olmali)
      //  * baskasi -> KESINLIKLE HAYIR
      allow update: if signedIn() && (
        (
          deviceExists(deviceId)
          && deviceOwner(deviceId) == uid()
          && recentSignIn()
          && request.resource.data.owner_id == uid()
          && (
            (!deviceReleased(deviceId) && request.resource.data.status == 'release_pending')
            || (deviceReleased(deviceId) && request.resource.data.status == 'active')
          )
        )
        || (isAdmin() && freshSignIn())
      );

      // Silme = baglanti kesme onayi -> cihazi serbest birakir. Yalnizca admin
      // ve TAZE GIRIS ile (cihaz sahipligi degistiren kritik islem).
      allow delete: if isAdmin() && freshSignIn();
    }

    // ================================================================
    // DEVICE_CODES - cihaz aktivasyon kodlari (cihazin kendi parolasi)
    //
    //  * Duz metin kodu SAKLANIR ama YALNIZCA ADMIN okuyabilir/yazabilir.
    //  * Normal kullanicilar bu kodlari HICBIR SEKILDE goremez; baglanti
    //    kurallari (device_bindings.create) kodu sunucu tarafinda karsilastirir.
    // ================================================================
    match /device_codes/{deviceId} {
      allow read: if isAdmin();
      // Duz metin parola yazma/silme: yalnizca admin ve TAZE GIRIS ile.
      allow write: if isAdmin() && freshSignIn();
    }

    // ================================================================
    // DEVICE_UNLOCKS - kod girisiyle olusan gecici dogrulama kaydi.
    //
    //  * Icerisinde duz metin kod bulundugu icin HIC KIMSE okuyamaz.
    //  * Olusturma: yalnizca ilgili cihazin dogru ve aktif koduyla.
    //  * device_bindings.create kurali bu kaydin varligina/uid'sine bakar.
    //  * Baglama tamamlaninca istemci kaydi siler.
    // ================================================================
    match /device_unlocks/{deviceId} {
      allow get, list: if false;

      allow create, update: if signedIn()
        && recentSignIn()
        && request.resource.data.uid == uid()
        && codeExists(deviceId)
        && codeData(deviceId).active == true
        && request.resource.data.code == codeData(deviceId).code;

      allow delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
    }

    // ================================================================
    // LOGIN_LOGS - giris/cikis etkinlik kayitlari
    // ================================================================
    match /login_logs/{logId} {
      // Yalnizca kendi adina kayit yazabilir.
      allow create: if signedIn() && request.resource.data.userId == uid();
      // Kendi kayitlarini veya admin tumunu okuyabilir.
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ================================================================
    // ALARM_EVENTS - olay gunlugu / alarm gecmisi
    //
    //  * Kayit: giris yapmis kullanici kendi adina; YALNIZCA gorebildigi
    //    (bosta veya kendine bagli) bir cihaz icin yazabilir.
    //  * Okuma: yalnizca kendi kayitlari veya admin tumunu.
    //  * Degistirme yok (kayitlar degismez); silme yalnizca admin.
    // ================================================================
    match /alarm_events/{eventId} {
      allow create: if signedIn()
                    && request.resource.data.owner_id == uid()
                    && (
                      isAdmin()
                      || !deviceExists(request.resource.data.dev)
                      || deviceOwner(request.resource.data.dev) == uid()
                    );

      allow read: if signedIn() && (resource.data.owner_id == uid() || isAdmin());

      allow update: if false;
      allow delete: if isAdmin();
    }

    // ================================================================
    // INVITES - davet kodlari
    // ================================================================
    match /invites/{code} {
      // Tek dokuman okuma serbest: kayit oncesi (henuz oturum yokken) dogrulanir.
      allow get: if true;
      // Liste/olusturma/silme yalnizca admin (ve TAZE GIRIS ile: davet
      // uretmek rol dagitmak demektir).
      allow list: if isAdmin();
      allow create, delete: if isAdmin() && freshSignIn();

      // Guncelleme: admin serbest (taze giris ile); ayrica kayit olan kullanici
      // KENDI adina, yalnizca kullanilmamis bir daveti "kullanildi"
      // isaretleyebilir. Rol/kod/olusturan alanlari degistirilemez.
      allow update: if (isAdmin() && freshSignIn()) || (
        signedIn()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.used_by == uid()
        && request.resource.data.role == resource.data.role
        && request.resource.data.code == resource.data.code
        && request.resource.data.created_by == resource.data.created_by
      );
    }

    // ================================================================
    // AUDIT_LOGS - yonetici islem kayitlari
    // ================================================================
    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ================================================================
    // EMERGENCY_CONTACTS - acil durum e-posta kişileri
    // Kullanıcı yalnızca kendi kişilerini yönetir. Gönderici (Vercel
    // fonksiyonu) servis hesabıyla okur; e-posta adresleri başka
    // kullanıcılara açılmaz.
    // ================================================================
    match /emergency_contacts/{contactId} {
      allow read: if signedIn() && resource.data.uid == uid();
      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.enabled is bool;
      allow update: if signedIn()
        && resource.data.uid == uid()
        && request.resource.data.uid == uid()
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.enabled is bool;
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // ================================================================
    // PUSH_SUBS - Web Push abonelikleri (arka plan bildirimi)
    // Panel yalnızca KENDİ aboneliğini yazar/siler. Gönderici (Vercel
    // fonksiyonu) servis hesabıyla okur; servis hesabı kuralları atlar.
    // Belge kimliği: <uid>__<uç nokta özeti>  (bkz. firebase.js pushDocId)
    // ================================================================
    match /push_subs/{subId} {
      allow read: if signedIn() && resource.data.uid == uid();
      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() > 20;
      allow update: if signedIn()
        && resource.data.uid == uid()
        && request.resource.data.uid == uid();
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // ================================================================
    // PUSH_TOKENS - Android FCM token'ları (uygulama kapalıyken alarm)
    // Kullanıcı yalnızca kendi token'ını yazar/siler. Vercel fonksiyonu
    // servis hesabıyla okur ve gönderir.
    // Belge kimliği: <uid>__<token özeti>  (bkz. firebase.js pushDocId)
    // ================================================================
    match /push_tokens/{tokenId} {
      allow read: if signedIn() && resource.data.uid == uid();
      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20;
      allow update: if signedIn()
        && resource.data.uid == uid()
        && request.resource.data.uid == uid();
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // ================================================================
    // Diger her sey varsayilan olarak kapali
    // ================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
