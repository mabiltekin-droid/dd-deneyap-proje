{
  "name": "nambir",
  "version": "2.20.1",
  "private": true,
  "description": "Deneyap Ev Koruma — ESP32 firmware + PWA kontrol paneli",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node tools/dev-server.js",
    "check": "node tools/check-js.js",
    "test:roles": "node tools/test-roles.js",
    "test:devices": "node tools/test-devices.js",
    "test:rules": "node tools/run-rules-test.js",
    "test:session": "node tools/test-session.js",
    "test:sun": "node tools/test-sun.js",
    "verify": "node tools/check-js.js && node tools/test-devices.js && node tools/test-roles.js && node tools/test-session.js && node tools/test-sun.js",
    "build": "node tools/build-web.js",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/make-icons.ps1",
    "fw": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-firmware.ps1 -Target both",
    "fw:mqtt": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-firmware.ps1 -Target mqtt",
    "fw:legacy": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-firmware.ps1 -Target legacy",
    "fw:ota": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-firmware.ps1 -Target mqtt -UploadNetwork",
    "fw:ota:legacy": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-firmware.ps1 -Target legacy -UploadNetwork",
    "deploy:rules": "npx --yes firebase-tools deploy --only firestore:rules",
    "deploy:indexes": "npx --yes firebase-tools deploy --only firestore:indexes",
    "deploy:firestore": "npx --yes firebase-tools deploy --only firestore",
    "firestore:list": "npx --yes firebase-tools firestore:indexes",
    "vapid": "node tools/gen-vapid.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "web-push": "^3.6.0"
  },
  "devDependencies": {
    "mqtt": "^5.16.0"
  }
}
